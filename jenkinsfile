pipeline {
    agent { label 'jenkins-agent' }

    tools {
        jdk 'java21'
        maven 'maven143'
    }

    environment {
        SONAR_PROJECT_KEY = 'joshi122_cloud123-jav'
        SONAR_ORG = 'joshi122'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github',
                    url: 'https://github.com/joshi122/cloud123-jav.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud Token') {
                    sh """
                        MAVEN_OPTS='-Xmx512m' mvn verify sonar:sonar \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.organization=${SONAR_ORG} \
                        -Dsonar.host.url=https://sonarcloud.io
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully ✅'
        }
        failure {
            echo 'Pipeline failed ❌'
        }
        always {
            cleanWs()
        }
    }
}
